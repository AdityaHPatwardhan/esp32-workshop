menu "Workshop: Person Detector"

    config WORKSHOP_WIFI_SSID
        string "Default Wi-Fi SSID"
        default "esp-workshop"
        help
            Used when no SSID is stored in NVS (flash.py --ssid or the
            `wifi` console command override it without rebuilding).

    config WORKSHOP_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default "espworkshop"

    config WORKSHOP_UDP_PORT
        int "Dashboard UDP broadcast port"
        default 5005

    config WORKSHOP_PERSON_THRESHOLD
        int "Person score threshold (%)"
        range 1 99
        default 60

    config WORKSHOP_LED_GPIO
        int "Status LED GPIO (-1 = none)"
        range -1 48
        default 2
        help
            Lights up while a person is detected.

    config WORKSHOP_LED_ACTIVE_LOW
        bool "Status LED is active-low"
        default n

    menu "Camera pins (default: ESP32-S3-EYE layout, used by most ESP32-S3-CAM boards)"
        config CAM_PIN_PWDN
            int "PWDN (-1 = not connected)"
            range -1 48
            default -1
        config CAM_PIN_RESET
            int "RESET (-1 = not connected)"
            range -1 48
            default -1
        config CAM_PIN_XCLK
            int "XCLK"
            range 0 48
            default 15
        config CAM_PIN_SIOD
            int "SIOD (SCCB SDA)"
            range 0 48
            default 4
        config CAM_PIN_SIOC
            int "SIOC (SCCB SCL)"
            range 0 48
            default 5
        config CAM_PIN_D0
            int "D0 (Y2)"
            range 0 48
            default 11
        config CAM_PIN_D1
            int "D1 (Y3)"
            range 0 48
            default 9
        config CAM_PIN_D2
            int "D2 (Y4)"
            range 0 48
            default 8
        config CAM_PIN_D3
            int "D3 (Y5)"
            range 0 48
            default 10
        config CAM_PIN_D4
            int "D4 (Y6)"
            range 0 48
            default 12
        config CAM_PIN_D5
            int "D5 (Y7)"
            range 0 48
            default 18
        config CAM_PIN_D6
            int "D6 (Y8)"
            range 0 48
            default 17
        config CAM_PIN_D7
            int "D7 (Y9)"
            range 0 48
            default 16
        config CAM_PIN_VSYNC
            int "VSYNC"
            range 0 48
            default 6
        config CAM_PIN_HREF
            int "HREF"
            range 0 48
            default 7
        config CAM_PIN_PCLK
            int "PCLK"
            range 0 48
            default 13
        config CAM_XCLK_FREQ_HZ
            int "XCLK frequency (Hz)"
            default 15000000
        config CAM_VFLIP
            bool "Flip image vertically"
            default y
    endmenu

endmenu
